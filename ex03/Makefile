.PHONY = all clean fclean re

NAME = fixed.out
CXX = c++
CXXFLAGS = -Wall -Wextra -Werror -std=c++98

SRCS = Fixed.cpp Point.cpp bsp.cpp main.cpp
INCS = Fixed.hpp Point.hpp
OBJS = $(SRCS:%.cpp=%.o)

all: $(NAME)

$(NAME): $(OBJS) $(INCS)
	$(CXX) $(CXXFLAGS) $(OBJS) -o $@

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -I. -c $< -o $@

clean:
	rm -rf $(OBJS)

fclean:
	rm -rf $(OBJS)
	rm -rf $(NAME)

re: fclean
	$(MAKE) all
